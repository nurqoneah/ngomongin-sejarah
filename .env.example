# Salin file ini jadi .env (JANGAN commit .env — sudah ada di .gitignore)
# Cara dapat nilainya: docs/SETUP-INSTAGRAM.md

# ID akun Instagram Profesional (angka, bukan username)
IG_USER_ID=
# Access token jangka panjang (60 hari) dengan izin instagram_content_publish
IG_ACCESS_TOKEN=
# Versi Graph API (opsional)
GRAPH_VERSION=v23.0
